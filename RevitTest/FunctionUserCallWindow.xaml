<Window x:Class="RevitTest.FunctionUserCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="MCP 指令面板"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="输入自然语言指令" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBox x:Name="TextBox"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"
                     MinHeight="120"
                     Margin="0,0,0,6"
                     TextChanged="TextBox_TextChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="发送" Width="90" Height="30" Margin="0,0,8,0" Click="Button_Click"/>
                <Button Content="清空" Width="90" Height="30" Click="Clear"/>
            </StackPanel>
        </StackPanel>

        <GridSplitter Grid.Row="1"
                       Height="4"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Stretch"
                       Background="LightGray"
                       ShowsPreview="True"
                       ResizeDirection="Rows"
                       ResizeBehavior="CurrentAndNext"/>

        

        <TextBox x:Name="OutputBox"
                 Grid.Row="3"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Height="100"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Foreground="Gray"
                 Margin="0,6,0,0"
                 Visibility="Collapsed"/>

        <TextBlock x:Name="WorkflowSummaryText"
                   Grid.Row="4"
                   Margin="0,8,0,4"
                   Text="工作流：总计 0 条，完成 0 条"/>

        <ListBox x:Name="WorkflowListBox"
                 Grid.Row="5"
                 Height="120"
                 BorderThickness="1"
                 BorderBrush="LightGray"/>
    </Grid>
</Window>
