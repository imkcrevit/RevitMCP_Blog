  </ImportGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgRevit_All_Main_Versions_API_x64 Condition=" '$(PkgRevit_All_Main_Versions_API_x64)' == '' ">C:\Users\xu.lanhui2\.nuget\packages\revit_all_main_versions_api_x64\2026.0.0</PkgRevit_All_Main_Versions_API_x64>
